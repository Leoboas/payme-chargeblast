# Demo default: no database, credentials, migrations, or Prisma runtime required.
PAYMENTS_DATA_SOURCE="json"
# Optional PostgreSQL mode only. Use Neon pooled URL at runtime and direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/payme?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/payme?sslmode=require"
